# ─── Server ───────────────────────────────────────
PORT=8000
NODE_ENV=development
VERIFICATION_PORTAL_URL=http://localhost:3000/verify

# ─── PostgreSQL ───────────────────────────────────
PGHOST=postgres
PGPORT=5432
PGUSER=trustmed
PGPASSWORD=change_me_in_production
PGDATABASE=trustmed

# ─── Redis ────────────────────────────────────────
REDIS_URL=redis://redis:6379

# ─── RabbitMQ ─────────────────────────────────────
RABBITMQ_URL=amqp://guest:guest@rabbitmq:5672

# ─── JWT RS256 Keys (base64-encoded PEM strings) ──
# Generate with: node generate-keys.js
# Then paste the base64 output here
JWT_PRIVATE_KEY=
JWT_PUBLIC_KEY=

# ─── HMAC Secret (for legal vault + webhooks) ─────
HMAC_SECRET=replace_with_64_char_hex_secret

# ─── Webhook ──────────────────────────────────────
WEBHOOK_TIMEOUT_MS=5000
WEBHOOK_MAX_RETRIES=3

# ─── MinIO (S3-compatible document storage) ───────
MINIO_ENDPOINT=localhost
MINIO_PORT=9000
MINIO_USE_SSL=false
MINIO_ACCESS_KEY=trustmed
MINIO_SECRET_KEY=trustmed123
MINIO_BUCKET=trustmed-documents

# ─── AES-256-CBC Document Encryption ─────────────
AES_DOCUMENT_KEY=replace_with_64_char_hex_key_for_32_bytes

# ─── Twilio (Phone OTP) ──────────────────────────
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=

# ─── Azure Document Intelligence (OCR) ───────────
AZURE_DOCUMENT_INTELLIGENCE_KEY=
AZURE_DOCUMENT_INTELLIGENCE_ENDPOINT=

# ─── CNOM Scraper Portals ─────────────────────────
CNOM_PORTAL_NATIONAL=https://cnomalgerie.dz/annuaire
CNOM_PORTAL_ALGER=https://sormdalger.dz/annuaire
CNOM_PORTAL_BLIDA=https://sorm-blida.dz/annuaire
CNOM_PORTAL_TIZI_OUZOU=https://crom-tiziouzou.dz/annuaire
CNOM_SCRAPE_DELAY_MS=2000
CNOM_SCRAPE_TIMEOUT_MS=15000

# ─── Compliance ──────────────────────────────────
COMPLIANCE_WEBHOOK_URL=http://localhost:8000/internal/compliance

# ─── Phase 4 ──────────────────────────────────────
ADMIN_JWT_SECRET=replace_with_64_char_hex_key_for_admin_jwt
SENDGRID_API_KEY=
DOMAIN=trustmed.dz
NODE_ENV=development
